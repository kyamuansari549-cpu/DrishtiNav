<?xml version="1.0" encoding="utf-8"?>
<!--
  DrishtiNav launcher mark, refined: an echolocation "sonar" — concentric
  rings collapsing to a warm amber core with a soft glow. Original mark:
  no borrowed logos, no starbursts.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer echo -->
    <path
        android:pathData="M21,54 A33,33 0 1,1 87,54 A33,33 0 1,1 21,54 Z"
        android:strokeWidth="3.5"
        android:strokeColor="#5BB5A5"
        android:strokeAlpha="0.32"
        android:strokeLineCap="round" />

    <!-- mid echo -->
    <path
        android:pathData="M30.5,54 A23.5,23.5 0 1,1 77.5,54 A23.5,23.5 0 1,1 30.5,54 Z"
        android:strokeWidth="4"
        android:strokeColor="#5BB5A5"
        android:strokeAlpha="0.58"
        android:strokeLineCap="round" />

    <!-- inner echo -->
    <path
        android:pathData="M40,54 A14,14 0 1,1 68,54 A14,14 0 1,1 40,54 Z"
        android:strokeWidth="4.5"
        android:strokeColor="#5BB5A5"
        android:strokeAlpha="0.85"
        android:strokeLineCap="round" />

    <!-- amber core: soft glow + solid heart -->
    <path
        android:pathData="M45,54 A9,9 0 1,1 63,54 A9,9 0 1,1 45,54 Z"
        android:fillColor="#FFB454"
        android:fillAlpha="0.26" />
    <path
        android:pathData="M48.5,54 A5.5,5.5 0 1,1 59.5,54 A5.5,5.5 0 1,1 48.5,54 Z"
        android:fillColor="#FFB454" />
</vector>
