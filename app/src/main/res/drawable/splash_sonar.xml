<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash mark: the DrishtiNav sonar. Rings are in named groups so the
  animated-vector can ping them outward one after another on launch.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="ring_outer"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.7"
        android:scaleY="0.7">
        <path
            android:pathData="M20,54 A34,34 0 1,1 88,54 A34,34 0 1,1 20,54 Z"
            android:strokeWidth="4"
            android:strokeColor="#5BB5A5"
            android:strokeAlpha="0.35" />
    </group>

    <group
        android:name="ring_mid"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.7"
        android:scaleY="0.7">
        <path
            android:pathData="M30,54 A24,24 0 1,1 78,54 A24,24 0 1,1 30,54 Z"
            android:strokeWidth="4"
            android:strokeColor="#5BB5A5"
            android:strokeAlpha="0.6" />
    </group>

    <group
        android:name="ring_inner"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.7"
        android:scaleY="0.7">
        <path
            android:pathData="M40,54 A14,14 0 1,1 68,54 A14,14 0 1,1 40,54 Z"
            android:strokeWidth="4.5"
            android:strokeColor="#5BB5A5" />
    </group>

    <group
        android:name="dot"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.5"
        android:scaleY="0.5">
        <path
            android:pathData="M45,54 A9,9 0 1,1 63,54 A9,9 0 1,1 45,54 Z"
            android:fillColor="#FFB454"
            android:fillAlpha="0.28" />
        <path
            android:pathData="M48.5,54 A5.5,5.5 0 1,1 59.5,54 A5.5,5.5 0 1,1 48.5,54 Z"
            android:fillColor="#FFB454" />
    </group>
</vector>
