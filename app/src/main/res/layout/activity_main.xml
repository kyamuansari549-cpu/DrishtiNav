<?xml version="1.0" encoding="utf-8"?>
<!--
  Main UI: fullscreen camera feed, slim branded app bar, and a premium
  bottom control deck — live status card, alert readout card, navigation
  card, and two large thumb-friendly actions. The screen is secondary to
  voice, so everything stays bold, high-contrast and touch-large for
  visually impaired users, sighted companions and demos.

  IDs consumed by MainActivity (do not rename): gl_surface, status_text,
  alert_text, nav_text, nav_card, sonar_view, toggle_button,
  navigate_button, setup_button.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <android.opengl.GLSurfaceView
        android:id="@+id/gl_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top app bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="34dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/sonar_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/Text.DrishtiNav.Headline"
                android:textSize="22sp"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setup_button"
            style="@style/Widget.DrishtiNav.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/setup" />
    </LinearLayout>

    <!-- Bottom control deck -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Live status card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.DrishtiNav.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.drishtinav.app.ui.SonarView
                    android:id="@+id/sonar_view"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/sonar_desc" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/live_status_label"
                        android:textAppearance="@style/Text.DrishtiNav.Label"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/status_idle"
                        android:textAppearance="@style/Text.DrishtiNav.Body"
                        android:textSize="15sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Alert readout card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.DrishtiNav.Card.Alert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="84dp"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="@string/alert_icon_desc"
                    android:src="@drawable/ic_alert" />

                <TextView
                    android:id="@+id/alert_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/teal"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Navigation card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nav_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/teal_container"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/teal_dim"
            app:strokeWidth="1.5dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/nav_icon_desc"
                    android:src="@drawable/ic_navigate"
                    app:tint="@color/on_teal_container" />

                <TextView
                    android:id="@+id/nav_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/on_teal_container"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle_button"
                style="@style/Widget.DrishtiNav.Button"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:contentDescription="@string/start_desc"
                android:text="@string/start"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navigate_button"
                style="@style/Widget.DrishtiNav.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:text="@string/navigate"
                app:icon="@drawable/ic_navigate"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
