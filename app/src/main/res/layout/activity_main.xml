<?xml version="1.0" encoding="utf-8"?>
<!--
  Main UI: fullscreen camera feed, a slim branded app bar, and a rounded
  bottom control panel with a live sonar indicator, alert readout and two
  large pill actions. The screen is secondary to voice — it stays bold,
  high-contrast and thumb-friendly for sighted companions and demos.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <android.opengl.GLSurfaceView
        android:id="@+id/gl_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top app bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/sonar_mark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setup_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/setup"
            android:textSize="14sp"
            app:cornerRadius="24dp"
            app:strokeColor="@color/teal"
            app:strokeWidth="1.5dp"
            android:textColor="@color/teal" />
    </LinearLayout>

    <!-- Bottom control panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.drishtinav.app.ui.SonarView
                android:id="@+id/sonar_view"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/sonar_desc" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/status_idle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/alert_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="60dp"
            android:text=""
            android:textColor="@color/teal"
            android:textSize="23sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nav_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            app:cardBackgroundColor="#12202E"
            app:cardCornerRadius="14dp"
            app:strokeColor="#2E6B8F"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/nav_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text=""
                android:textColor="#9fd8ff"
                android:textSize="17sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle_button"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:contentDescription="@string/start_desc"
                android:text="@string/start"
                android:textSize="17sp"
                app:backgroundTint="@color/teal"
                android:textColor="@color/black"
                app:cornerRadius="36dp"
                app:icon="@drawable/ic_play"
                app:iconTint="@color/black"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navigate_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:text="@string/navigate"
                android:textSize="17sp"
                app:cornerRadius="36dp"
                app:strokeColor="@color/teal"
                app:strokeWidth="2dp"
                android:textColor="@color/teal"
                app:icon="@drawable/ic_navigate"
                app:iconTint="@color/teal"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
