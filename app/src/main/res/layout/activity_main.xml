<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 1 UI: fullscreen camera feed, a high-contrast status strip for sighted
  companions / demo recording, and one very large start/stop button.
  All spoken feedback goes through TTS — the screen is secondary.
  Phase 2: adds a navigation instruction strip + NAVIGATE button.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <android.opengl.GLSurfaceView
        android:id="@+id/gl_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/overlay_scrim"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_idle"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/setup_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Open settings"
                android:minWidth="64dp"
                android:text="@string/setup" />
        </LinearLayout>

        <TextView
            android:id="@+id/alert_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text=""
            android:textColor="@color/teal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nav_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9fd8ff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/toggle_button"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:contentDescription="@string/start_desc"
            android:text="@string/start"
            android:textSize="20sp" />

        <Button
            android:id="@+id/navigate_button"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:text="@string/navigate"
            android:textSize="20sp" />
    </LinearLayout>

</FrameLayout>
